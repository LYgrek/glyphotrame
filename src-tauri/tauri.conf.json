{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphotrame",
  "version": "1.0.0",
  "identifier": "fr.lymonstudio.glyphotrame",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glyphotrame",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": {
          "fr-FR": { "localePath": "wix/fr-FR.wxl" }
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQjMxMTAwRjBGNjEyOEUKUldTT0V2YndBQkd6UWZMK25WQTh5d0FoSjNqbmlsOWRPengxSVo4S2JMRjZIV1VKbHkxcHVQK1cK",
      "endpoints": [
        "https://github.com/LYgrek/glyphotrame-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
